        </mxCell>
        <mxCell id="26" value="Activar tras pago verificado.&#10;No repetir evento externo.&#10;Renovar actualiza la vigencia.&#10;Cancelar conserva período pagado.&#10;E: PlanUpgradedToPremium / PlanDowngradedToFree." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=27.0;fontStyle=0;fontColor=#1a1a1a;" vertex="1" parent="1">
