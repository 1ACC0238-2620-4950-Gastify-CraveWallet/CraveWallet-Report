          <mxGeometry x="1594.0" y="387.5" width="742.0" height="37.0" as="geometry" />
        </mxCell>
        <mxCell id="28" value="Google Places (U; externo)&#10;Q: buscar comercios&#10;R: MerchantSuggestion&#10;ACL: GooglePlacesAdapter&#10; &#10;Suscripciones: Separate Ways&#10;El Dashboard compone lecturas, sin intercambio entre agregados." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=28.0;fontStyle=0;fontColor=#1a1a1a;" vertex="1" parent="1">
