          <mxGeometry x="784.0" y="387.5" width="762.0" height="37.0" as="geometry" />
        </mxCell>
        <mxCell id="24" value="Gasto: importe registrado por pedido.&#10;Comercio: negocio asociado.&#10;Período: mes del gasto.&#10;Límite: tope elegido.&#10;Exceso: acumulado superior al tope." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=27.0;fontStyle=0;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="784.0" y="456.5" width="762.0" height="155.25" as="geometry" />
