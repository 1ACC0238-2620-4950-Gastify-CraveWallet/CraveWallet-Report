        <mxCell id="24" value="Free: nivel gratuito con límite.&#10;Premium: acceso pagado.&#10;Vigencia: intervalo cubierto.&#10;Pago confirmado: resultado verificado.&#10;Cancelación: fin de la renovación propia." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=27.0;fontStyle=0;fontColor=#1a1a1a;" vertex="1" parent="1">
