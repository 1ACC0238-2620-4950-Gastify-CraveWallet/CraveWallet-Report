        <mxCell id="30" value="El usuario mantiene sus datos.&#10;La conversión es una estimación.&#10;El dispositivo admite recordatorios." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=28.0;fontStyle=0;fontColor=#1a1a1a;" vertex="1" parent="1">
