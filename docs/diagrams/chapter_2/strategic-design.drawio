        <mxCell id="25" value="Business Decisions" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=32.0;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="784.0" y="782.5" width="762.0" height="37.0" as="geometry" />
        </mxCell>
        <mxCell id="26" value="DeliveryExpense y MonthlyBudget son agregados del mismo contexto.&#10;Contar cada gasto una sola vez.&#10;E: DeliveryExpenseRegistered / MonthlyLimitExceeded.&#10;Permitir comercio manual." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=27.0;fontStyle=0;fontColor=#1a1a1a;" vertex="1" parent="1">
