        <mxCell id="24" value="Suscripción: registro de un compromiso con un tercero.&#10;Importe original: monto y moneda.&#10;Estimación PEN: valor de referencia.&#10;Cancelada: estado del registro local." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=27.0;fontStyle=0;fontColor=#1a1a1a;" vertex="1" parent="1">
