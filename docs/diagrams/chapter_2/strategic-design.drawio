        <mxCell id="28" value="Stripe (U; externo)&#10;C/R: crear checkout / sesión&#10;C/R: cancelar renovación / vigencia&#10;Q/R: reconciliar estado&#10;ACL: StripeGatewayAdapter&#10; &#10;Las respuestas a consultas entrantes pertenecen a la misma colaboración." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=28.0;fontStyle=0;fontColor=#1a1a1a;" vertex="1" parent="1">
