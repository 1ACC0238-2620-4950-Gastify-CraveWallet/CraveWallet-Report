        </mxCell>
        <mxCell id="26" value="Comprobar límite antes del alta.&#10;Conservar moneda original e historial.&#10;E: SubscriptionRegistered / SubscriptionCancelled.&#10;El móvil ejecuta el aviso 24 h antes, con permiso." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=27.0;fontStyle=0;fontColor=#1a1a1a;" vertex="1" parent="1">
