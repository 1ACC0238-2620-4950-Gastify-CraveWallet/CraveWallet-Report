  "components": {
    "schemas": {
      "BudgetRequest": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "format": "int32",
            "maximum": 9999,
            "minimum": 1900
          },
          "month": {
            "type": "integer",
            "format": "int32",
            "maximum": 12,
            "minimum": 1
          },
          "spendingLimit": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "month",
          "year"
        ]
      },
      "BudgetResource": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "format": "int32"
          },
          "month": {
            "type": "integer",
            "format": "int32"
          },
          "currency": {
            "type": "string"
          },
          "spendingLimit": {
            "type": "number"
          },
          "accumulated": {
            "type": "number"
          },
          "remaining": {
            "type": "number"
          },
          "exceeded": {
            "type": "boolean"
          }
        }
      },
      "SubscriptionRegisterRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "amount": {
            "type": "number",
            "minimum": 0.0
          },
          "currency": {
            "type": "string",
            "enum": [
              "PEN",
              "USD"
            ]
          },
          "category": {
            "type": "string",
            "maxLength": 60,
            "minLength": 0
          },
          "billingCycle": {
            "type": "string",
            "enum": [
              "MONTHLY",
              "ANNUAL"
            ]
          },
          "nextBillingDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "amount",
          "billingCycle",
          "category",
          "currency",
          "name",
          "nextBillingDate"
        ]
      },
      "Resource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "enum": [
              "PEN",
              "USD"
            ]
          },
          "category": {
            "type": "string"
          },
          "billingCycle": {
            "type": "string",
            "enum": [
              "MONTHLY",
              "ANNUAL"
            ]
          },
          "nextBillingDate": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "CANCELLED"
            ]
          },
          "cancelledAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DeliveryRegisterRequest": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "merchant": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "category": {
            "type": "string",
            "maxLength": 60,
            "minLength": 0
          },
          "expenseDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "amount",
          "category",
          "expenseDate",
          "merchant",
          "requestId"
        ]
      },
      "ExpenseResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "merchant": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "expenseDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "Credentials": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 0
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthenticationResource": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/ProfileResource"
          }
        }
      },
      "ProfileResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "referenceCurrency": {
            "type": "string"
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "maxLength": 256,
            "minLength": 0
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ProfileRequest": {
        "type": "object",
        "properties": {
          "referenceCurrency": {
            "type": "string",
            "minLength": 1,
            "pattern": "PEN"
          }
        },
        "required": [
          "referenceCurrency"
        ]
      },
      "EditRequest": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "minimum": 0.0
          },
          "category": {
            "type": "string",
            "maxLength": 60,
            "minLength": 0,
            "pattern": ".*\\S.*"
          },
          "nextBillingDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "Portfolio": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Resource"
            }
          },
          "monthlyTotalsByCurrency": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "monthlyTotalPen": {
            "type": "number"
          },
          "conversionAvailable": {
            "type": "boolean"
          },
          "exchangeRate": {
            "$ref": "#/components/schemas/Rate"
          }
        }
      },
      "Rate": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "enum": [
              "PEN",
              "USD"
            ]
          },
          "to": {
            "type": "string",
            "enum": [
              "PEN",
              "USD"
            ]
          },
          "rate": {
            "type": "number"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "stale": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          },
          "attributionUrl": {
            "type": "string"
          }
        }
      },
      "ReminderResource": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "reminderAt": {
            "type": "string",
            "format": "date-time"
          },
          "billingAt": {
            "type": "string",
            "format": "date-time"
          },
          "timeZone": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "Summary": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "format": "int32"
          },
          "month": {
            "type": "integer",
            "format": "int32"
          },
          "currency": {
            "type": "string"
          },
          "total": {
            "type": "number"
          },
          "spendingLimit": {
            "type": "number"
          },
          "remaining": {
            "type": "number"
          },
          "exceeded": {
            "type": "boolean"
          },
          "totalsByCategory": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "totalsByWeek": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
