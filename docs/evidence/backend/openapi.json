                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "authentication-controller"
        ],
        "summary": "Cerrar la sesión actual e invalidar ambos tokens — US33",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "authentication-controller"
        ],
        "summary": "Iniciar sesión — US02 / TS01",
